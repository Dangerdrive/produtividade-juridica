{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "app/templates/**",
        "app/modules/**/templates/**",
        "app/static/**"
      ],
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/prazos/cron/sync", "schedule": "0 11 * * *" }
  ]
}
