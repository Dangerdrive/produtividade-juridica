# ---------------------------------------------------------------------------
# Copie para `.env` e preencha. NUNCA comite o .env.
# ---------------------------------------------------------------------------

# Banco de dados.
# Local:      sqlite:///./data/prazos.db
# Produção:   postgresql+psycopg://usuario:senha@host/banco   (Neon/Supabase/Vercel Postgres)
DATABASE_URL=sqlite:///./data/prazos.db

# Fuso usado na apresentação das datas
TIMEZONE=America/Sao_Paulo

# --- Gmail (OAuth2) --------------------------------------------------------
# Gere o refresh token com:  python scripts/authorize_gmail.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=in:inbox
GMAIL_LOOKBACK_DAYS=60
GMAIL_MAX_MENSAGENS_POR_EXECUCAO=25
GMAIL_MARCAR_COMO_LIDA=true

# --- DeepSeek --------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Google Sheets (espelho dos dados + dashboard em Apps Script) -----------
# Conteúdo do JSON da conta de serviço (cru, em uma linha, ou em base64).
# Compartilhe a planilha com o e-mail da conta de serviço como Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=DB_Prazos
SHEETS_SYNC_ATIVO=true

# --- Segurança -------------------------------------------------------------
# Token exigido em /api/sync e /api/cron/sync
SYNC_TOKEN=
# Protege o dashboard com HTTP Basic (usuário: admin). Deixe vazio para desligar.
APP_PASSWORD=

# --- Limites de execução (serverless) --------------------------------------
MAX_SEGUNDOS_POR_EXECUCAO=45
