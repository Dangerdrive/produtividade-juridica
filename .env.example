# ---------------------------------------------------------------------------
# Copie para `.env` e preencha. NUNCA comite o .env.
# ---------------------------------------------------------------------------

# Banco de dados.
# Local:      sqlite:///./data/prazos.db
# Produção:   postgresql+psycopg://usuario:senha@host/banco   (Neon/Supabase/Vercel Postgres)
DATABASE_URL=sqlite:///./data/prazos.db

# Fuso usado na apresentação das datas
TIMEZONE=America/Sao_Paulo

# --- Gmail (OAuth2) --------------------------------------------------------
# Gere o refresh token com:  python scripts/authorize_gmail.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=in:inbox
GMAIL_LOOKBACK_DAYS=60
GMAIL_MAX_MENSAGENS_POR_EXECUCAO=25
GMAIL_MARCAR_COMO_LIDA=true

# --- Múltiplas contas Gmail (opcional) ---------------------------------------
# JSON com nome -> conta, ou caminho de um arquivo JSON com as contas.
# Contas podem omitir client_id/client_secret para reutilizar os da conta padrão.
# Gere uma conta adicional com:
#   python scripts/authorize_gmail.py --contas-file gmail_contas.json \
#     --conta trabalho --rotulo "Conta do escritório" --write-env
GMAIL_ACCOUNTS_JSON=
GMAIL_ACCOUNTS_FILE=
# Nome da conta usada quando o comando não informa --conta.
GMAIL_CONTA_PADRAO=

# --- DeepSeek --------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Google (conta de serviço compartilhada) --------------------------------
# Conteúdo do JSON da conta de serviço (cru, em uma linha, ou em base64).
# Compartilhe cada planilha/documento com o e-mail da conta de serviço como Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternativa mais prática: caminho para o arquivo JSON baixado do Google Cloud.
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Módulo de prazos (espelho dos dados + dashboard em Apps Script) --------
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=DB_Prazos
SHEETS_SYNC_ATIVO=true

# --- Módulo de repasses -----------------------------------------------------
# Planilha específica do módulo (aba com ID, Cliente, Processo, Valor,
# Data Prevista, Data do Pagamento, Status, Responsável, Observações).
REPASSES_SHEET_ID=
REPASSES_SHEET_TAB=Repasses
# Segredo para gerar links individuais de acompanhamento por cliente.
# Gere com: openssl rand -hex 32
REPASSES_CLIENTE_TOKEN_SECRET=
# Token das rotas de escrita/leitura da API interna de repasses.
# Se vazio, usa SYNC_TOKEN.
REPASSES_API_TOKEN=
# Mapeamento opcional de colunas (JSON: campo -> cabeçalho exato da planilha).
# Ex.: {"data_prevista": "Vencimento", "responsavel": "Analista"}
REPASSES_COLUNAS_JSON=

# --- Segurança -------------------------------------------------------------
# Token exigido em /api/prazos/sync e /api/prazos/cron/sync
SYNC_TOKEN=
# Protege o dashboard com HTTP Basic (usuário: admin). Deixe vazio para desligar.
APP_PASSWORD=

# --- Limites de execução (serverless) --------------------------------------
MAX_SEGUNDOS_POR_EXECUCAO=45
